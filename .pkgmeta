package-as: RollAway

externals:
  RollAway/Libs/LibStub: https://github.com/BigWigsMods/LibKeystone.git/LibStub
  RollAway/Libs/LibKeystone: https://github.com/BigWigsMods/LibKeystone.git/LibKeystone

move-folders:
  RollAway/RollAway: RollAway

ignore:
  - .github/*
  - .gitattributes
  - .gitignore
  - LICENSE.md
  - README.md

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
